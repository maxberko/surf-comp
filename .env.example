# Copy to `.env` and fill with your Supabase project values.
# Both are safe to expose in a client bundle (anon key is public + RLS-guarded).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Mode démo : backend factice en mémoire (données seedées, aucune config requise).
# Mets EXPO_PUBLIC_DEMO=1 pour lancer l'app sans Supabase (pratique pour itérer l'UI).
# EXPO_PUBLIC_DEMO=1
